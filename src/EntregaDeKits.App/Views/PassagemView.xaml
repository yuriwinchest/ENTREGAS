<UserControl x:Class="EntregaDeKits.App.Views.PassagemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="2,8,2,2">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Anexar a lista do evento -->
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Content="Anexar lista" Click="Attach_Click" Style="{StaticResource OrangeButton}" MinWidth="140" Margin="0,0,10,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="RosterText" Text="Anexe a planilha dos inscritos (Excel, TXT, CSV, XML ou PDF)." FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="RosterDetailText" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <Border Grid.Column="2" Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="12,7" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="ArmedDot" Width="10" Height="10" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock x:Name="ArmedText" Text="Leitora pausada" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="0.62*" MinWidth="300"/>
      </Grid.ColumnDefinitions>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="160"/>
        </Grid.RowDefinitions>

        <!-- Ultima passagem -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="6"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Orange}" CornerRadius="3,3,0,0"/>
            <StackPanel Grid.Row="1" Margin="20,14,20,16">
              <TextBlock Text="ÚLTIMA PASSAGEM" Foreground="{StaticResource Orange}" FontWeight="Bold" FontSize="12"/>
              <TextBlock x:Name="StateText" Text="ANEXE A LISTA" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="RunnerText" Text="Nenhuma lista carregada" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <TextBlock x:Name="RunnerDetailText" Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <Border x:Name="DiagnosticPanel" Visibility="Collapsed" Background="{StaticResource FieldFill}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,10" Margin="0,12,0,0" CornerRadius="3">
                <StackPanel>
                  <TextBlock Text="POR QUE NÃO ACHEI" Foreground="{StaticResource Muted}" FontWeight="Bold" FontSize="11"/>
                  <TextBlock x:Name="DiagnosticText" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Captura bruta -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="14,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CaptureTitle" Text="CAPTURA DAS TAGS" Foreground="{StaticResource Orange}" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="Toda passagem em frente à leitora, inclusive as repetidas." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Limpar captura" Click="ClearCapture_Click" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ListView x:Name="CaptureList" Grid.Row="1" Background="{StaticResource FieldFill}" BorderBrush="{StaticResource Line}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Position}"/>
                  <GridViewColumn Header="EPC / Código" Width="240" DisplayMemberBinding="{Binding Code}"/>
                  <GridViewColumn Header="Primeira" Width="95" DisplayMemberBinding="{Binding FirstAt}"/>
                  <GridViewColumn Header="Última" Width="95" DisplayMemberBinding="{Binding LastAt}"/>
                  <GridViewColumn Header="Leituras" Width="70" DisplayMemberBinding="{Binding Reads}"/>
                  <GridViewColumn Header="Corredor" Width="230" DisplayMemberBinding="{Binding Runner}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </Border>
      </Grid>

      <StackPanel Grid.Column="2">
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="LEITORA DE MESA" Foreground="{StaticResource Orange}" FontWeight="Bold" FontSize="12"/>
            <TextBlock Text="Modo teclado (HID)" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" Margin="0,4,0,8"/>
            <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                       Text="A leitora se comporta como um teclado: não precisa de driver, IP nem SDK. Basta o cabo USB conectado e esta aba aberta. Passe o chip em frente à antena e ele aparece sozinho na tabela."/>
            <Border Background="{StaticResource FieldFill}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="11" Margin="0,10,0,0" CornerRadius="3">
              <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                         Text="A captura pausa enquanto o cursor estiver dentro de um campo de texto. Clique fora do campo para armar de novo."/>
            </Border>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="18">
          <StackPanel>
            <TextBlock Text="TESTE SEM A LEITORA" Foreground="{StaticResource Orange}" FontWeight="Bold" FontSize="12"/>
            <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,8"
                       Text="Digite um CHIP da planilha e confirme para simular uma passagem."/>
            <TextBox x:Name="ManualCodeBox" VerticalContentAlignment="Center" KeyDown="ManualCode_KeyDown"/>
            <Button Content="Simular passagem" Click="Simulate_Click" Style="{StaticResource OrangeButton}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
