<UserControl x:Class="EntregaDeKits.App.Views.TelaoBoard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    O VISUAL DO TELÃO, EM UM LUGAR SÓ.

    Usado pela janela que vai para a TV e pela prévia da aba TELÃO. O desenho
    mora aqui para não divergir entre os dois.

    SOBRE O FUNDO: a arte do evento estava sumindo. O véu escuro cobria a tela
    inteira de maneira uniforme, então para o nome do corredor ficar legível a
    arte precisava quase desaparecer. Agora o escurecimento é concentrado: fica
    forte atrás do bloco de dados, onde o texto precisa de contraste, e fraco
    nas bordas, onde a arte pode respirar. O cartão central também ficou mais
    opaco, então a legibilidade não depende mais de apagar o fundo.

    O LOGO DA PROVA é outra imagem, exibida limpa no alto. Usar a mesma arte
    como fundo e como logo era o que deixava a marca apagada: ela recebia o véu
    junto com o resto.
  -->
  <Grid Background="Black">
    <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.9"/>

    <!-- Véu de baixo para cima: escuro no miolo, leve nas bordas -->
    <Rectangle>
      <Rectangle.Fill>
        <RadialGradientBrush GradientOrigin="0.5,0.52" Center="0.5,0.52" RadiusX="0.78" RadiusY="0.72">
          <GradientStop Color="#F00B0D0E" Offset="0.0"/>
          <GradientStop Color="#D40B0D0E" Offset="0.55"/>
          <GradientStop Color="#6B0B0D0E" Offset="1.0"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid Width="1440" Height="810" Margin="64">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho: identificação da operação, logo da prova e marca -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Rectangle Width="9" Height="62" Fill="#FFFF6A00" Margin="0,0,18,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="BoardTitle" Text="ENTREGA DE KITS" Foreground="#FFFF6A00" FontFamily="Bahnschrift SemiCondensed" FontSize="26" FontWeight="Bold"/>
              <TextBlock Text="CHIPOWER • OPERAÇÃO DO EVENTO" Foreground="#FFC4CACE" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
            </StackPanel>
          </StackPanel>

          <!-- Logo da prova: sem véu, sem moldura, o mais limpo possível -->
          <Image x:Name="EventLogo" Grid.Column="1" Height="104" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0"
                 Visibility="Collapsed"/>

          <Border Grid.Column="2" Background="#D914181A" BorderBrush="#4DFFFFFF" BorderThickness="1" CornerRadius="4" Padding="18,10">
            <Image Source="pack://application:,,,/EntregaDeKits;component/Resources/chipower-escuro.jpeg" Height="56" Width="176" Stretch="Uniform"/>
          </Border>
        </Grid>

        <!-- Corpo: estado, número em destaque, nome e a grade de dados -->
        <Border Grid.Row="1" Background="#E8101314" BorderBrush="#59FFFFFF" BorderThickness="1" CornerRadius="6" Padding="52,40" Margin="0,44,0,36" VerticalAlignment="Center">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="State" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#FFFF6A00" FontFamily="Bahnschrift SemiCondensed" FontSize="34" FontWeight="Bold" TextWrapping="Wrap"/>

            <!-- Número de peito: o dado que se lê de longe -->
            <StackPanel x:Name="NumberPanel" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="32,0,0,0">
              <TextBlock Text="NÚMERO" Foreground="#FFC4CACE" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,0,2"/>
              <TextBlock x:Name="Number" Foreground="#FFFF6A00" FontFamily="Bahnschrift SemiCondensed" FontSize="96" FontWeight="Bold" HorizontalAlignment="Right" LineHeight="96"/>
            </StackPanel>

            <TextBlock x:Name="ParticipantName" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="White" FontFamily="Bahnschrift SemiCondensed" FontSize="82" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0"/>

            <!-- Grade montada a partir do que a planilha realmente trouxe -->
            <ItemsControl x:Name="FieldList" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,30,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="22,12" Margin="0,0,16,14">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" Foreground="#FFC4CACE" FontSize="17" FontWeight="Bold"/>
                      <TextBlock Text="{Binding Value}" Foreground="#FFF6F5EE" FontFamily="Bahnschrift SemiCondensed" FontSize="38" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#F2FF6A00" Padding="24,16" CornerRadius="4">
          <TextBlock x:Name="Detail" Foreground="#FF101112" FontFamily="Bahnschrift SemiCondensed" FontSize="27" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
      </Grid>
    </Viewbox>
  </Grid>
</UserControl>
