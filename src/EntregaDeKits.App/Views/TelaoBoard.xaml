<UserControl x:Class="EntregaDeKits.App.Views.TelaoBoard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    O VISUAL DO TELÃO, EM UM LUGAR SÓ.

    Usado pela janela que vai para a TV e pela prévia da aba TELÃO.

    A TELA É DIVIDIDA EM DOIS: o banner do evento ocupa todo o espaço livre no
    alto, e o bloco com os dados do corredor fica embaixo. Foi o que resolveu o
    corte da arte: antes o bloco morava no meio e cobria justamente o miolo do
    desenho, e a arte como fundo ainda era recortada para preencher a tela.
    Aqui a imagem é reduzida por inteiro (Uniform), então nada some.

    O espaço de cima é grande de propósito. Todo mundo na fila olha para esta
    tela, então ali cabe o logo da prova ou um banner de divulgação.

    NÃO HÁ FAIXA DE RECADO NO RODAPÉ. "Confirme a entrega do kit no notebook" é
    instrução para quem opera, e o telão é do público. O que sobrou do recado
    virou uma linha discreta dentro do bloco, para as mensagens que interessam
    a quem está na frente da tela — como uma etiqueta não encontrada.
  -->
  <Grid Background="Black">
    <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.9"/>

    <Rectangle>
      <Rectangle.Fill>
        <RadialGradientBrush GradientOrigin="0.5,0.72" Center="0.5,0.72" RadiusX="0.85" RadiusY="0.8">
          <GradientStop Color="#EB0B0D0E" Offset="0.0"/>
          <GradientStop Color="#C90B0D0E" Offset="0.55"/>
          <GradientStop Color="#5E0B0D0E" Offset="1.0"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid Width="1440" Height="810" Margin="60,40,60,40">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Faixa fina de identificação da operação -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Rectangle Width="7" Height="46" Fill="#FFFF6A00" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="BoardTitle" Text="ENTREGA DE KITS" Foreground="#FFFF6A00" FontFamily="Bahnschrift SemiCondensed" FontSize="22" FontWeight="Bold"/>
              <TextBlock Text="CHIPOWER • OPERAÇÃO DO EVENTO" Foreground="#FFC4CACE" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Background="#D914181A" BorderBrush="#4DFFFFFF" BorderThickness="1" CornerRadius="4" Padding="14,8" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/EntregaDeKits;component/Resources/chipower-escuro.jpeg" Height="42" Width="132" Stretch="Uniform"/>
          </Border>
        </Grid>

        <!--
          Banner do evento: FAIXA LARGA DE ALTURA FIXA, no espírito da capa do
          YouTube ou do banner de topo de site.

          O TETO DE ALTURA é o que segura tudo. Antes esta área era elástica e
          crescia com o espaço livre: uma arte quadrada esticava até ocupar a
          tela inteira e engolia o resto do telão.

          A faixa toma a altura NATURAL da imagem na largura do telão, até 300.
          Um banner largo de 1440x186 ocupa 171 e nada mais — o bloco de dados
          sobe e encosta nele, sem espaço morto no meio. Uma arte quadrada para
          nos 300, aparece inteira e centralizada, e não invade a tela.

          Stretch Uniform mantém a arte inteira: nunca há corte.
        -->
        <Image x:Name="EventLogo" Grid.Row="1" MaxHeight="300" Stretch="Uniform"
               HorizontalAlignment="Center" Margin="0,22,0,0"
               Visibility="Collapsed"/>

        <!-- Bloco de dados do corredor, encostado embaixo -->
        <!--
          O bloco de dados ESTICA para ocupar tudo o que sobra abaixo do banner.

          Antes ele tinha altura própria e ficava encostado embaixo, deixando um
          vão preto entre o banner e ele — pior ainda com banner largo e baixo,
          que ocupa pouca altura. Esticando, banner e bloco preenchem a tela
          juntos e não existe mais espaço vazio, seja qual for a proporção da
          arte. O conteúdo fica centralizado dentro do bloco.
        -->
        <Border x:Name="DataCard" Grid.Row="2" Background="#EB101314" BorderBrush="#59FFFFFF" BorderThickness="1" CornerRadius="6" Padding="44,26" Margin="0,22,0,0">
          <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="State" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#FFFF6A00" FontFamily="Bahnschrift SemiCondensed" FontSize="30" FontWeight="Bold" TextWrapping="Wrap"/>

            <StackPanel x:Name="NumberPanel" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="28,0,0,0">
              <TextBlock Text="NÚMERO" Foreground="#FFC4CACE" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
              <TextBlock x:Name="Number" Foreground="#FFFF6A00" FontFamily="Bahnschrift SemiCondensed" FontSize="80" FontWeight="Bold" HorizontalAlignment="Right" LineHeight="80"/>
            </StackPanel>

            <TextBlock x:Name="ParticipantName" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="White" FontFamily="Bahnschrift SemiCondensed" FontSize="72" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0"/>

            <ItemsControl x:Name="FieldList" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,18,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="20,10" Margin="0,0,14,12">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" Foreground="#FFC4CACE" FontSize="16" FontWeight="Bold"/>
                      <TextBlock Text="{Binding Value}" Foreground="#FFF6F5EE" FontFamily="Bahnschrift SemiCondensed" FontSize="34" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recado discreto: só o que interessa a quem está na frente da tela -->
            <TextBlock x:Name="Detail" Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed"
                       Foreground="#FFC4CACE" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </Grid>
        </Border>
      </Grid>
    </Viewbox>
  </Grid>
</UserControl>
