<UserControl x:Class="EntregaDeKits.App.Views.TelaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EntregaDeKits.App.Views">
  <Grid Margin="2,8,2,2">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="ONDE EXIBIR" Foreground="{StaticResource Muted}" FontWeight="Bold" FontSize="11"/>
          <ComboBox x:Name="ScreenPicker" MinWidth="230" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button x:Name="DetachButton" Content="Destacar para a TV" Click="Detach_Click" Style="{StaticResource OrangeButton}" MinWidth="180"/>
          <Button x:Name="ReattachButton" Content="Trazer de volta" Click="Reattach_Click" MinWidth="150"/>
        </StackPanel>

        <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Orientation="Horizontal">
          <Button Content="Escolher fundo" Click="Background_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
      <Grid>
        <views:TelaoBoard x:Name="Board"/>
        <Border x:Name="DetachedVeil" Visibility="Collapsed" Background="#B3000000">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="O TELÃO ESTÁ NA TV" Foreground="#FFFF6A00" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DetachedWhereText" Foreground="White" FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="Esta prévia continua acompanhando o que o público está vendo." Foreground="#FFD7DCDE" FontSize="12.5" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="2,8,2,0" TextWrapping="Wrap"
               Text="O telão abre numa janela própria, sem bordas, para arrastar até a televisão. Feche pelo botão do canto ou pela tecla Esc."/>
  </Grid>
</UserControl>
