<UserControl x:Class="EntregaDeKits.App.Views.TelaoBoard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    O VISUAL DO TELÃO, EM UM LUGAR SÓ.

    Este mesmo controle é usado pela janela que vai para a TV e pela aba TELÃO
    dentro do programa. Antes o desenho vivia solto dentro da janela: qualquer
    ajuste teria de ser feito duas vezes, e uma hora as duas telas divergiriam.

    O Viewbox faz o conteúdo caber tanto num monitor de 55" quanto na prévia de
    alguns centímetros dentro da aba, sem nenhum cálculo de tamanho.
  -->
  <Grid Background="Black">
    <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.5"/>
    <Rectangle Fill="#D60B0D0E"/>
    <Rectangle Margin="28" Stroke="#42FFFFFF" StrokeThickness="1"/>
    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid Width="1440" Height="810" Margin="70">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
          <Rectangle Width="10" Height="72" Fill="#FFFF6A00" Margin="0,0,20,0"/>
          <StackPanel>
            <TextBlock x:Name="BoardTitle" Text="ENTREGA DE KITS" Foreground="#FFFF6A00" FontFamily="Bahnschrift SemiCondensed" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="CHIPOWER • OPERAÇÃO DO EVENTO" Foreground="#FFD7DCDE" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Background="#C914181A" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="3" Padding="20,12">
          <Image Source="pack://application:,,,/EntregaDeKits;component/Resources/chipower-escuro.jpeg" Height="62" Width="190" Stretch="Uniform"/>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#B9121517" BorderBrush="#4CFFFFFF" BorderThickness="1" CornerRadius="5" Padding="48,38" Margin="0,62,0,52" VerticalAlignment="Center">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="State" Foreground="#FFFF6A00" FontFamily="Bahnschrift SemiCondensed" FontSize="35" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ParticipantName" Foreground="White" FontFamily="Bahnschrift SemiCondensed" FontSize="88" FontWeight="Bold" TextWrapping="Wrap" Margin="0,17,0,22"/>
            <Border x:Name="InfoBox" Background="#1CFFFFFF" Padding="18,13" HorizontalAlignment="Left" MaxWidth="1180">
              <TextBlock x:Name="Info" Foreground="#FFF6F5EE" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#E8FF6A00" Padding="23,15" CornerRadius="3">
          <TextBlock x:Name="Detail" Foreground="#FF101112" FontFamily="Bahnschrift SemiCondensed" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
      </Grid>
    </Viewbox>
  </Grid>
</UserControl>
