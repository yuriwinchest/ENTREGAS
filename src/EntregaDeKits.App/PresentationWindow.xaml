<Window x:Class="EntregaDeKits.App.PresentationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EntregaDeKits.App.Views"
        Title="CHIPOWER | Telão"
        Icon="pack://application:,,,/EntregaDeKits;component/Resources/chipower.ico"
        WindowStyle="None" ResizeMode="NoResize" Background="Black"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <views:TelaoBoard x:Name="Board"/>
    <Button Panel.ZIndex="10" Content="Fechar telão  ×" Click="Close_Click"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24" Padding="16,10"
            Background="#D914181A" BorderBrush="#FFFF6A00" Foreground="White"
            ToolTip="Fechar telão (Esc)"/>
  </Grid>
</Window>
