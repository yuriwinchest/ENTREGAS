<Window x:Class="EntregaDeKits.App.PresentationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EntregaDeKits.App.Views"
        Title="CHIPOWER | Telão"
        Icon="pack://application:,,,/EntregaDeKits;component/Resources/chipower.ico"
        WindowStyle="None" ResizeMode="NoResize" Background="Black"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <!--
      NADA DE BOTAO AQUI.

      Esta janela vai para a televisao e fica exposta ao publico o evento
      inteiro. Um botao "Fechar telao" no canto e ruido permanente numa tela
      que deveria mostrar so a marca do evento e o corredor.

      Quem fecha e o operador, pelo botao "Trazer de volta" na aba TELAO do
      computador — que e onde ele esta trabalhando de qualquer forma. A tecla
      Esc continua funcionando como saida de emergencia, sem ocupar espaco.
    -->
    <views:TelaoBoard x:Name="Board"/>
  </Grid>
</Window>
